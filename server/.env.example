# Server
PORT=3000

# Admin key — for internal admin routes only
ADMIN_KEY=change-me-before-deploy

# Neon (Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# JWT secret — sign with a long random string (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Paystack — get from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Paystack plan codes — create plans on Paystack dashboard first, then paste the codes here
PAYSTACK_BASIC_PLAN_CODE=PLN_xxxxxxxxxx
PAYSTACK_PRO_PLAN_CODE=PLN_xxxxxxxxxx
PAYSTACK_BUSINESS_PLAN_CODE=PLN_xxxxxxxxxx

# Your deployed app URL (used for Paystack callback redirect)
APP_URL=https://sms-gate-app.vercel.app

# Your dashboard URL (user is redirected here after payment)
DASHBOARD_URL=https://sms-gate-app.vercel.app
